// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model user {
  id          String       @id @default(cuid())
  name        String
  email       String       @unique
  picture     String?
  dodo_customer_id String @default("") @unique
  accounts    account[]
  sessions    session[]
  medias      media[]
  generations generation[]
  usage     usage?
  faces       face[]
  created_at  DateTime     @default(now())
  updated_at  DateTime     @updatedAt
}
enum user_plan {
  FREE
  PRO
}
model usage {
  id          String     @id @default(cuid())
  user_id       String   @unique
  user          user     @relation(references: [id], fields: [user_id], onDelete: Cascade)
  no_of_videos_generated  Int @default(0) 
  allowed_limit Int @default(10)
  plan      user_plan @default(FREE)
  created_at  DateTime     @default(now())
  updated_at  DateTime     @updatedAt
}

enum account_type {
  GOOGLE
}
enum blur_type{
    PIXELATE
  GAUSSIAN 
  BLACKOUT 
  ELLIPTICAL
  MEDIAN 
}

enum generation_type{
  BLUR_PERSON
  BLUR_LICENSE_PLATE
  BLUR_PERSON_IMAGE
}

model account {
  id            String   @id @default(cuid())
  user_id       String
  user          user     @relation(references: [id], fields: [user_id], onDelete: Cascade)
  refresh_token String
  expires_at    DateTime
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  scope         String
}

model session {
  id      String @id @default(cuid())
  user_id String
  user    user   @relation(references: [id], fields: [user_id], onDelete: Cascade)

  ip         String?
  ua         String
  expires_at DateTime
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model media {
  id      String @id @default(cuid())
  user_id String
  user    user   @relation(references: [id], fields: [user_id], onDelete: Cascade)
  key     String 
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

}

model face {
   id      String @id @default(cuid())
  user_id String
  user    user   @relation(references: [id], fields: [user_id], onDelete: Cascade)
  key     String 
  media_id String
  generations generation[]
  embedding String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}
enum generationStatus {
  STARTED
  FAILED
  COMPLETED
}
model generation {
  id      String @id @default(cuid())
  user_id String
  user    user   @relation(references: [id], fields: [user_id], onDelete: Cascade)
  output_key     String? 
  input_media_id  String
  output_media_id  String?
  blur_type blur_type
  generation_type generation_type
  face_id String?
  status   generationStatus @default(STARTED)
  face   face?   @relation(references: [id], fields: [face_id], onDelete: SetNull)
  
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([id, user_id,status])
}